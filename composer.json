{
  "name": "civicride/backend",
  "description": "CivicRide multi-tenant ride dispatch API (Laravel 13)",
  "type": "project",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0",
    "laravel/sanctum": "^4.0",
    "league/flysystem-aws-s3-v3": "^3.35"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0",
    "mockery/mockery": "^1.6",
    "phpstan/phpstan": "2.2",
    "larastan/larastan": "^3.10"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php artisan test"
  },
  "config": {
  "process-timeout": 0,
    "platform": {
      "php": "8.3"
    }
}
}
