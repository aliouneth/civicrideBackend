{
  "name": "civicride/backend",
  "description": "CivicRide multi-tenant ride dispatch API (Laravel 13)",
  "type": "project",
  "require": {
    "php": "^8.0",
    "laravel/framework": "^9.0",
    "laravel/sanctum": "^3.1",
    "league/flysystem-aws-s3-v3": "^3.25"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0",
    "laravel/boost": "^2.8",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.4"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php artisan test"
  },
  "config": {
    "policy": {
      "advisories": {
        "ignore": ["PKSA-b41t-wbzk-9q51,PKSA-d5tc-s1qs-h781,PKSA-3r5d-mb8f-1qw9,PKSA-m5cs-t1y6-qpcs,PKSA-mdq4-51ck-6kdq,PKSA-8qx3-n5y5-vvnd,PKSA-w7xr-vk7n-rstm"]
      }
    }
  }
}
